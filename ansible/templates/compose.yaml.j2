# Managed by Ansible ({{ template_destpath | default('answer-server.yaml') }}).
# Local edits are overwritten on the next run.
services:
  pve-answer:
    image: {{ pve_answer_image }}
    container_name: pve-answer
    restart: unless-stopped
    ports:
      - "{{ pve_answer_port }}:8443"
    environment:
      - PVE_ANSWER_HOSTNAMES={{ pve_answer_hostnames | join(',') }}
      - PVE_ANSWER_TOKEN_FILE=/app/private/token
    volumes:
      - ./public:/app/public
      - ./private:/app/private
